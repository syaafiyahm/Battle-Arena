/*=============================================================================
    Battle Arena : Board 2 - LIVE REACTION COMMENTATOR
    Target      : Nuvoton NUC140VE3AN (NuTiny / LB-002 Learning Board)
    Toolchain   : Keil uVision (ARM-ADS, armcc)

    -------------------------------------------------------------------------
    Still no gameplay runs here - Board 1 (BattleArena_Board1_Master.c) is
    the only board tracking HP/position/timer. This board:

      1) Shows a cover screen ("READY !!!") and waits for ITS OWN key 5,
         then waits for Board 1 to also confirm ready, before mirroring
         the (slowed-down) countdown - see CMD_PLAYER_READY / CMD_COUNTDOWN.
      2) During battle, reacts to lightweight event packets from Board 1:
           CMD_HIT    -> random "OUCHH !!!" / "BOOM !!!" / "BAMMM !!!"
           CMD_IDLE   -> "COME ON !!"
           CMD_LOSING -> "[BOY/GIRL] LOSING !!"
         and blinks its LED every time a new line appears.
      3) Shows the final result (unchanged from before) once Board 1
         sends CMD_GAME_OVER.

    Wiring: this board's UART0 RX <- Board 1's UART0 TX, shared GND, and
    NOW ALSO this board's UART0 TX -> Board 1's UART0 RX (the ready
    handshake needs Board 2 to talk back), so cross-connect both wires.

    Font note: the LCD library only has the built-in 5x7 bitmap font used
    by print_Line()/printS_5x7() (same one everything else here uses) -
    there's no separate "comic" font available. The exclamation-heavy
    caps text below is as playful as this font gets; a genuinely
    different look would need pre-rendered bitmap word graphics (like
    starting_word/boywin already are) - happy to wire those in if you
    produce the art.
=============================================================================*/

#include <stdio.h>
#include "NUC1xx.h"
#include "SYS.h"
#include "GPIO.h"
#include "UART.h"
#include "LCD.h"
#include "Scankey.h"
#include "Seven_Segment.h"
#include "Sprites.h"

/*-----------------------------------------------------------------------
  Board / pin configuration - same as Board 1
-----------------------------------------------------------------------*/
#define UART_CH             UART_PORT0
#define UART_BAUD           115200

#define LED_PORT            E_GPA
#define LED_GREEN_PIN       13
#define LED_RED_PIN         14
#define LED_BLUE_PIN        12

#define BUZZER_PORT         E_GPA
#define BUZZER_PIN          11

#define KEY_NONE            0
#define KEY_READY           5

/*-----------------------------------------------------------------------
  UART packet protocol   [ CMD , DATA ]   (2 bytes)
-----------------------------------------------------------------------*/
#define CMD_PLAYER_READY    0x0C
#define CMD_COUNTDOWN       0x0D
#define CMD_HIT             0x0E
#define CMD_IDLE            0x0F
#define CMD_LOSING          0x10

#define CMD_RESULT_BOY      0x0A
#define CMD_RESULT_GIRL     0x0B
#define CMD_GAME_OVER       0x07
#define CMD_RESTART         0x08

#define CD_STAGE_STARTING   0
#define CD_STAGE_3          1
#define CD_STAGE_2          2
#define CD_STAGE_1          3
#define CD_STAGE_GO         4

typedef enum
{
    DSTATE_READY_WAIT,      /* cover screen, waiting for OUR key 5 */
    DSTATE_WAITING_OTHER,   /* we're ready, waiting for Board 1    */
    DSTATE_COUNTDOWN,
    DSTATE_COMMENTARY,      /* battle running, reacting to events  */
    DSTATE_RESULT
} E_DISPLAY_STATE;

static E_DISPLAY_STATE g_state;
static int16_t g_boyHP  = 0;
static int16_t g_girlHP = 0;
static uint8_t g_lastKey = KEY_NONE;
static uint16_t g_msgSeed = 1;   /* simple LCG seed for picking reactions */

static char g_lcdLine[24];

/*=============================================================================
    Low level helpers
=============================================================================*/
static void Delay_ms(uint32_t ms)
{
    DrvSYS_Delay(ms * 1000UL);
}

static void UART_SendPacket(uint8_t cmd, uint8_t data)
{
    uint8_t buf[2];
    buf[0] = cmd;
    buf[1] = data;
    DrvUART_Write(UART_CH, buf, 2);
}

#define UART_RXBUF_SIZE   32
static volatile uint8_t  s_rxBuf[UART_RXBUF_SIZE];
static volatile uint16_t s_rxHead = 0;
static volatile uint16_t s_rxTail = 0;

static void UART_RxISR(uint32_t userData)
{
    uint8_t b;
    (void)userData;

    while (UART0->ISR.RDA_IF == 1)
    {
        DrvUART_Read(UART_PORT0, &b, 1);
        {
            uint16_t nextHead = (uint16_t)((s_rxHead + 1) % UART_RXBUF_SIZE);
            if (nextHead != s_rxTail)
            {
                s_rxBuf[s_rxHead] = b;
                s_rxHead = nextHead;
            }
        }
    }
}

static int32_t UART_TryReceiveByte(uint8_t *outByte)
{
    if (s_rxHead == s_rxTail)
        return 0;
    *outByte = s_rxBuf[s_rxTail];
    s_rxTail = (uint16_t)((s_rxTail + 1) % UART_RXBUF_SIZE);
    return 1;
}

static int32_t UART_TryReceivePacket(uint8_t *cmd, uint8_t *data)
{
    uint16_t avail = (uint16_t)((s_rxHead - s_rxTail + UART_RXBUF_SIZE) % UART_RXBUF_SIZE);
    if (avail < 2)
        return 0;
    UART_TryReceiveByte(cmd);
    UART_TryReceiveByte(data);
    return 1;
}

static void Buzzer_Beep(uint16_t on_ms, uint16_t off_ms, uint8_t repeat)
{
    uint8_t i;
    for (i = 0; i < repeat; i++)
    {
        DrvGPIO_SetBit(BUZZER_PORT, BUZZER_PIN);
        Delay_ms(on_ms);
        DrvGPIO_ClrBit(BUZZER_PORT, BUZZER_PIN);
        if (off_ms) Delay_ms(off_ms);
    }
}

static void LED_AllOff(void)
{
    DrvGPIO_ClrBit(LED_PORT, LED_GREEN_PIN);
    DrvGPIO_ClrBit(LED_PORT, LED_RED_PIN);
    DrvGPIO_SetBit(LED_PORT, LED_BLUE_PIN);
}

/* Blinks whenever a new commentary line appears on screen */
static void LED_BlinkForNewMessage(void)
{
    DrvGPIO_ClrBit(LED_PORT, LED_GREEN_PIN);
    DrvGPIO_ClrBit(LED_PORT, LED_RED_PIN);
    Delay_ms(150);
    DrvGPIO_SetBit(LED_PORT, LED_GREEN_PIN);
    DrvGPIO_SetBit(LED_PORT, LED_RED_PIN);
    Delay_ms(80);
    DrvGPIO_ClrBit(LED_PORT, LED_GREEN_PIN);
    DrvGPIO_ClrBit(LED_PORT, LED_RED_PIN);
}

/* Cheap pseudo-random - good enough for "which reaction word to show" */
static uint8_t NextRandom(uint8_t rangeExclusive)
{
    g_msgSeed = (uint16_t)(g_msgSeed * 25173 + 13849);
    return (uint8_t)((g_msgSeed >> 4) % rangeExclusive);
}

static uint8_t DebounceKey(uint8_t rawKey)
{
    uint8_t pressed = KEY_NONE;
    if (rawKey != KEY_NONE && rawKey != g_lastKey)
        pressed = rawKey;
    g_lastKey = rawKey;
    return pressed;
}

/*=============================================================================
    System bring-up
=============================================================================*/
static void Hardware_Init(void)
{
    STR_UART_T uartCfg;

    UNLOCKREG();
    DrvSYS_Open(50000000);
    LOCKREG();

    DrvGPIO_InitFunction(E_FUNC_UART0);

    uartCfg.u32BaudRate       = UART_BAUD;
    uartCfg.u8cDataBits       = DRVUART_DATABITS_8;
    uartCfg.u8cStopBits       = DRVUART_STOPBITS_1;
    uartCfg.u8cParity         = DRVUART_PARITY_NONE;
    uartCfg.u8cRxTriggerLevel = DRVUART_FIFO_1BYTES;
    uartCfg.u8TimeOut         = 0;
    DrvUART_Open(UART_CH, &uartCfg);
    DrvUART_EnableInt(UART_CH, DRVUART_RDAINT, UART_RxISR);

    DrvGPIO_Open(LED_PORT, LED_GREEN_PIN, E_IO_OUTPUT);
    DrvGPIO_Open(LED_PORT, LED_RED_PIN,   E_IO_OUTPUT);
    DrvGPIO_Open(LED_PORT, LED_BLUE_PIN,  E_IO_OUTPUT);
    LED_AllOff();

    DrvGPIO_Open(BUZZER_PORT, BUZZER_PIN, E_IO_OUTPUT);
    DrvGPIO_ClrBit(BUZZER_PORT, BUZZER_PIN);

    close_seven_segment();

    init_LCD();
    clear_LCD();
    OpenKeyPad();
}

/*=============================================================================
    Screens
=============================================================================*/
static void ShowReadyCover(void)
{
    clear_LCD();
    draw_LCD((unsigned char *)splash_screen);
    print_Line(3, "READY !!!");
}

static void ShowWaitingForOther(void)
{
    clear_LCD();
    print_Line(0, "BATTLE ARENA");
    print_Line(1, "You are ready!");
    print_Line(2, "Waiting for");
    print_Line(3, "other board...");
}

static void ShowCountdownStage(uint8_t stage)
{
    switch (stage)
    {
        case CD_STAGE_STARTING: draw_LCD((unsigned char *)starting_word); Buzzer_Beep(150,0,1); break;
        case CD_STAGE_3:        draw_LCD((unsigned char *)digit_3);       Buzzer_Beep(100,0,1); break;
        case CD_STAGE_2:        draw_LCD((unsigned char *)digit_2);       Buzzer_Beep(100,0,1); break;
        case CD_STAGE_1:        draw_LCD((unsigned char *)digit_1);       Buzzer_Beep(100,0,1); break;
        case CD_STAGE_GO:       draw_LCD((unsigned char *)start_word);    Buzzer_Beep(300,0,1); break;
        default: break;
    }

    if (stage == CD_STAGE_GO)
    {
        clear_LCD();
        print_Line(0, "  LIVE COMMENTARY");
        print_Line(2, "COME ONN !!");
        g_state = DSTATE_COMMENTARY;
    }
}

static void ShowHitReaction(uint8_t who)
{
    /* print_Line() takes a non-const char*, so the picked reaction is
       copied into a local mutable buffer rather than passed as a
       const string-table pointer directly. */
    static char reactions[3][12] = { "OUCHH !!!", "BOOM !!!", "BAMMM !!!" };
    uint8_t pick = NextRandom(3);

    clear_LCD();
    print_Line(0, "  LIVE COMMENTARY");
    print_Line(1, (who == 1) ? "BOY GOT HIT!" : "GIRL GOT HIT!");
    print_Line(2, reactions[pick]);

    LED_BlinkForNewMessage();
}

static void ShowIdleReaction(void)
{
    clear_LCD();
    print_Line(0, "  LIVE COMMENTARY");
    print_Line(2, "COME ONN !!");

    LED_BlinkForNewMessage();
}

static void ShowLosingReaction(uint8_t who)
{
    clear_LCD();
    print_Line(0, "  LIVE COMMENTARY");
    print_Line(2, (who == 1) ? "BOY LOSING !!" : "GIRL LOSING !!");

    LED_BlinkForNewMessage();
}

static void ShowResultScreen(uint8_t winnerCode)
{
    clear_LCD();

    if (winnerCode == 1)
    {
        draw_LCD((unsigned char *)boywin);
        Buzzer_Beep(120, 100, 3);
        Delay_ms(2000);
        clear_LCD();
        print_Line(0, "GAME OVER");
        print_Line(1, "BOY WINS!");
    }
    else if (winnerCode == 2)
    {
        draw_LCD((unsigned char *)girlwin);
        Buzzer_Beep(120, 100, 3);
        Delay_ms(2000);
        clear_LCD();
        print_Line(0, "GAME OVER");
        print_Line(1, "GIRL WINS!");
    }
    else
    {
        print_Line(0, "GAME OVER");
        print_Line(1, "DRAW");
        Buzzer_Beep(200, 200, 2);
    }

    sprintf(g_lcdLine, "Boy:%d Girl:%d", g_boyHP, g_girlHP);
    print_Line(2, g_lcdLine);
    print_Line(3, "Waiting for next match...");

    DrvGPIO_SetBit(LED_PORT, LED_GREEN_PIN);
    DrvGPIO_SetBit(LED_PORT, LED_RED_PIN);
}

/*=============================================================================
    main
=============================================================================*/
int main(void)
{
    uint8_t cmd, data, key;

    Hardware_Init();
    g_state = DSTATE_READY_WAIT;
    ShowReadyCover();

    while (1)
    {
        /* handle our own local "ready" key while waiting */
        if (g_state == DSTATE_READY_WAIT)
        {
            key = DebounceKey(ScanKey());
            if (key == KEY_READY)
            {
                UART_SendPacket(CMD_PLAYER_READY, 0);
                g_state = DSTATE_WAITING_OTHER;
                ShowWaitingForOther();
            }
        }
        else if (g_state == DSTATE_WAITING_OTHER)
        {
            /* keep re-announcing in case Board 1 missed the first one */
            UART_SendPacket(CMD_PLAYER_READY, 0);
        }

        while (UART_TryReceivePacket(&cmd, &data))
        {
            switch (cmd)
            {
                case CMD_COUNTDOWN:
                    if (g_state == DSTATE_WAITING_OTHER || g_state == DSTATE_COUNTDOWN)
                    {
                        g_state = DSTATE_COUNTDOWN;
                        ShowCountdownStage(data);   /* flips to COMMENTARY on GO */
                    }
                    break;

                case CMD_HIT:
                    if (g_state == DSTATE_COMMENTARY)
                        ShowHitReaction(data);
                    break;

                case CMD_IDLE:
                    if (g_state == DSTATE_COMMENTARY)
                        ShowIdleReaction();
                    break;

                case CMD_LOSING:
                    if (g_state == DSTATE_COMMENTARY)
                        ShowLosingReaction(data);
                    break;

                case CMD_RESULT_BOY:
                    g_boyHP = data;
                    break;

                case CMD_RESULT_GIRL:
                    g_girlHP = data;
                    break;

                case CMD_GAME_OVER:
                    g_state = DSTATE_RESULT;
                    ShowResultScreen(data);
                    break;

                case CMD_RESTART:
                    LED_AllOff();
                    g_lastKey = KEY_NONE;
                    g_state = DSTATE_READY_WAIT;
                    ShowReadyCover();
                    break;

                default:
                    break;
            }
        }

        Delay_ms(50);
    }
}
